import rtconfig
from building import *

cwd     = GetCurrentDir()
src     = Split("""
main.c
env.c
env_cmd.c
""")
if GetDepend(['BSP_USING_KA_DOWN']):
    src += ['dtu_Ka.c','Ka_down.c']
if GetDepend(['BSP_USING_X_DOWN']):
    src += ['dtu_X.c','X_down.c']
if GetDepend(['BSP_USING_Q_DOWN']):
    src += ['dtu_Q.c','Q_down.c']

group = DefineGroup('Applications', src, depend = [''])

Return('group')
