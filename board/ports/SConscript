import os
from building import *

objs = []
cwd  = GetCurrentDir()

# add general drivers
src = []
path =  [cwd]

if GetDepend(['BSP_SCB_ENABLE_I_CACHE']) or GetDepend(['BSP_SCB_ENABLE_D_CACHE']):
    src += Glob('drv_mpu.c')
    
if GetDepend(['BSP_USING_FS']):
    src += Glob('drv_filesystem.c')
    if GetDepend(['BSP_USING_SPI_FLASH_LITTLEFS']):
        src += Glob('fal/fal_spi_flash_sfud_port.c')
        path += [cwd + '/fal']
        
if GetDepend(['BSP_USING_QSPI_FLASH']):
    src += Glob('drv_qspi_flash.c')

if GetDepend(['FAL_PART_HAS_TABLE_CFG']):
    path += [cwd + '/fal']
    if GetDepend(['FAL_USING_SFUD_PORT']):
        src += Glob('fal/fal_spi_flash_sfud_port.c')

if GetDepend(['BSP_USING_SDMMC']):
    src += Glob('drv_sdio.c')
    
if GetDepend(['BSP_USING_DCMI']):
    src += Glob('drv_dcmi.c')
    
if GetDepend(['BSP_USING_OV2640']):
    src += Glob('drv_ov2640.c')

if GetDepend(['BSP_USING_ETH_H750']):
    src += Glob('drv_eth.c')

CPPDEFINES = ['STM32H743xx']
group = DefineGroup('Drivers', src, depend = [''], CPPPATH = path, CPPDEFINES = CPPDEFINES)

list = os.listdir(cwd)
for item in list:
    if os.path.isfile(os.path.join(cwd, item, 'SConscript')):
        group = group + SConscript(os.path.join(item, 'SConscript'))

Return('group')
